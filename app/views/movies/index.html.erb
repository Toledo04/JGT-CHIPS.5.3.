<h1>Movies</h1>

<%= form_tag movies_path, method: :get, id: 'ratings_form' do %>
  Include:
  <% @all_ratings.each do |rating| %>
    <%= rating %>
    <%= check_box_tag "ratings[#{rating}]", "1", @ratings_to_show.include?(rating), id: "ratings_#{rating}" %>
  <% end %>
  <%= submit_tag 'Refresh', id: 'ratings_submit' %>
<% end %>

<table id="movies" class="table table-striped table-hover">
  <caption class="visually-hidden">All movies.</caption>
  <thead>
    <tr>
      <th scope="col" aria-sort="<%= sort_aria('title') %>" class="<%= sort_classes('title') %>">
        <%= link_to movies_path(sort_by: 'title', ratings: @selected_ratings_hash), id: 'title_header' do %>
          Movie Title<%= sort_indicator('title') %>
        <% end %>
      </th>
      <th scope="col">Rating</th>
      <th scope="col" aria-sort="<%= sort_aria('release_date') %>" class="<%= sort_classes('release_date') %>">
        <%= link_to movies_path(sort_by: 'release_date', ratings: @selected_ratings_hash), id: 'release_date_header' do %>
          Release Date<%= sort_indicator('release_date') %>
        <% end %>
      </th>
      <th scope="col">More Info</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <%= render 'movie_row', movie: movie %>
    <% end %>
  </tbody>
</table>

<%= link_to "New movie", new_movie_path, class: 'btn btn-primary' %>