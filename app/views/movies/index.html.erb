<h1>Movies</h1>

<%= form_tag movies_path, method: :get, id: 'ratings_form' do %>
  Include:
  <% @all_ratings.each do |rating| %>
    <%= rating %>
    <%= check_box_tag "ratings[#{rating}]", "1", @selected_ratings.include?(rating), id: "ratings_#{rating}" %>
  <% end %>
  <%= submit_tag 'Refresh', id: 'ratings_submit' %>
<% end %>

<table id="movies" class="table table-striped table-hover">
  <caption class="visually-hidden">All movies.</caption>
  <thead>
    <tr>
      <th scope="col" class="<%= 'hilite' if @sort == 'title' %>">
        <%= link_to 'Movie Title', movies_path(sort: 'title', ratings: @selected_ratings_hash), id: 'title_header' %>
      </th>
      <th scope="col">Rating</th>
      <th scope="col" class="<%= 'hilite' if @sort == 'release_date' %>">
        <%= link_to 'Release Date', movies_path(sort: 'release_date', ratings: @selected_ratings_hash), id: 'release_date_header' %>
      </th>
      <th scope="col">More Info</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <%= render 'movie_row', movie: movie %>
    <% end %>
  </tbody>
</table>

<%= link_to "New movie", new_movie_path, class: 'btn btn-primary' %>